# app config
PORT=
REDIS_URL=
REDIS_KEY_PREFIX=
# MONGO_URL=mongodb://localhost:27017/guesstheai
MONGO_URL=

BACKUP_BASE_URL=
OG_IMAGE_BASE_URL=https://indexer-storage-turbo.0g.ai/file?root=
# Used by npm run manifest:upload-0g (Indexer API base URL, without /file?root=)
ZG_STORAGE_INDEXER_URL=https://indexer-storage-turbo.0g.ai
# Optional upload tuning (foundation SDK defaults are fine for most manifests)
ZG_UPLOAD_TASK_SIZE=10
ZG_UPLOAD_EXPECTED_REPLICA=1
# Separate key for storage uploads only (defaults to ONCHAIN_PRIVATE_KEY when unset)
ZG_STORAGE_PRIVATE_KEY=

# Published manifest (schema v2: name "Guess The AI", entries hash -> "ai"|"human").
# npm run manifest:labels → upload data/guesstheai-image-label-manifest.json → paste 0G storage root.
IMAGE_LABEL_MANIFEST_STORAGE_ROOT=
# Optional: record CLI “manifestFileSha256” after each rebuild (documentation only).
IMAGE_LABEL_MANIFEST_SHA256=
# Optional dev: path to manifest file instead of 0G (leave STORAGE_ROOT empty to use LOCAL only)
IMAGE_LABEL_MANIFEST_LOCAL_PATH=
IMAGE_LABEL_MANIFEST_FETCH_MS=12000
IMAGE_LABEL_MANIFEST_CACHE_MS=300000
# Bearer token required for POST /api/verify/image-label/cache/purge
MANIFEST_PURGE_API_KEY=

OG_FETCH_TIMEOUT_MS=1200
CORS_ALLOWED_ORIGINS=

GALAXY_FESTIVAL=false
GATE_FESTIVAL=false;
# jwt conf
JWT_SECRET=
BROWSER_JWT_SECRET=
JWT_EXPIRES_IN=

VRF_SECRET_KEY=

# must be put in false in production
ENABLE_CRASH_ENDPOINT=

# web sockets activity tracking config
# only multiplier of this value will be accepted
PRESENCE_CLIENT_FLUSH_QUANTUM_MS=
# wait to this value before flush to mongo
PRESENCE_DURABLE_BATCH_MS=
# ttl in redis
PRESENCE_REDIS_TTL_SECONDS=
# interval to run sweeper for flushing
PRESENCE_FLUSH_INTERVAL_MS=

# cache ahead config
# should load data from redis first or not
LOAD_FROM_REDIS=
# interval(seconds) to flush redis data in mongo
REDIS_DATA_FLUSH=
# number of users needs to be flushed in one time
REDIS_DATA_FLUSH_BATCH=

# --- Warmup / cache targets ---
CACHE_MIN_READY=
WARMER_CONCURRENCY=

# Optional background top-up loop (keeps queue near target)
PER_TOPUP_INTERVAL_SEC=
PER_TOPUP_TARGET=

# --- Privy configuration ---
PRIVY_APP_ID=
PRIVY_SECRET_KEY=
PRIVY_CHAIN_TYPE=ethereum
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=
PRIVY_DEBUG=false

# --- Gate campaign config ---
GATE_DEBUG=0
REDIS_DATA_FLUSH_GATE=

# --- Game session config ---
GAME_SESSION_TTL_SEC=

# --- Debug options ---
DEBUG_V2_LOGIN=false

# --- Onchain / Blockchain configuration ---
ONCHAIN_RPC_URL=
ONCHAIN_PRIVATE_KEY=
ONCHAIN_CHAIN_ID=16661



ONCHAIN_CONTRACT_ADDRESS=0x4aCfb1a2Dc270846A7913757189543e4C18F7826

ONCHAIN_CHAIN_NAME=0G Mainnet
ONCHAIN_CHAIN_CURRENCY=OG
ONCHAIN_CHAIN_DECIMALS=18
ONCHAIN_SEASON_ID=1
ONCHAIN_ANSWER_CONTRACT_ADDRESS=0x73d377634F906fD24fE342fd95182c3c80bCFe49
ONCHAIN_LEADERBOARD_CONTRACT_ADDRESS=0x9663dA1163842cfbac83D382Bdf331227d012114

# --- 0G DA ingestion ---
# Optional external DA writer URL.
# If empty, backend uses internal endpoint: http://127.0.0.1:<PORT>/api/internal/da/submit
DA_API_URL=
DA_API_KEY=
DA_BATCH_SIZE=20
DA_FLUSH_INTERVAL_MS=15000
DA_TIMEOUT_MS=12000
DA_INTERNAL_API_KEY=
DA_UPSTREAM_URL=
DA_UPSTREAM_API_KEY=

# --- Deployed DA event gateway (zero_g_da_event_gateway) ---
# Base URL only (no trailing slash). Backend POSTs session.login etc. to /v1/events
# DA_INGEST_API_KEY must equal the gateway env INGEST_API_KEY (Bearer token).
DA_GATEWAY_URL=https://da.example.com
DA_INGEST_API_KEY=
DA_GATEWAY_TIMEOUT_MS=8000
DA_GAME_ID=guess_the_ai
DA_GATEWAY_PUBLISH_ANSWERS=true

