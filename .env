CACHE_DIR=./cache/orig

# -------- Image file fetching (0g) --------
# Primary mode for warming files; cold path in GET /img uses HTTP pass-through.
FETCH_MODE=HTTP              # HTTP | CLI
FETCH_FALLBACK=true          # try the other mode if primary fails

OGSOURCE_BASE=https://indexer-storage-testnet-turbo.0g.ai/file?root=
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai/
OG_CLI_BIN=0g-storage-client
OG_CLI_PROOF=false
OG_CLI_RPC_RETRY_COUNT=5
OG_CLI_RPC_RETRY_INTERVAL=5s
OG_CLI_RPC_TIMEOUT=30s

# HTTP fetch limits
HTTP_READ_TIMEOUT_MS=45000
HTTP_MAX_CONTENT_BYTES=5242880

# -------- Truth labels source --------
KV_MODE=MONGO                # MONGO | CLI (we're using Mongo now)

# -------- Configurable Expiry and Per-User Images ---------
ACTIVE_USER_EXPIRY_SEC=600      # e.g., 10 minutes
PER_USER_IMAGES=50               # images per active user for top-up

# -------- Game rules --------
IMAGE_COOLDOWN_DAYS=7        # per-user cooldown
IMAGE_GLOBAL_COOLDOWN_DAYS=1 # global embargo window (0 = disabled)

# -------- New uploads sync --------
TOPUP_NEW_LIMIT=500          # how many to try per /admin/topup/new call

# --- Warmup / cache targets ---
CACHE_MIN_READY=100              # target # of hashes preloaded in Redis ready:q
STARTUP_WARM_FROM_MONGO=true    # on boot: fill to target using images collection (hash+uploadedAt)
STARTUP_WARM_LIMIT=2000         # max images to attempt on boot
WARMER_CONCURRENCY=8            # parallel fetches when warming

# Optional background top-up loop (keeps queue near target)
PREFETCH_INTERVAL_SEC=1000         # 0 = disabled; e.g., 60 to check every 60s
PREFETCH_TARGET=500             # target to maintain in ready:q

# pool sizing
CACHE_MIN_READY=200
CACHE_MAX_READY=1000

# warmer cadence
WARMER_TICK_MS=500
WARMER_CONCURRENCY=8

# cooldowns (keep your current values if set)
IMAGE_COOLDOWN_DAYS=7
IMAGE_GLOBAL_COOLDOWN_DAYS=2

# hard guarantee
GUARANTEE_ALWAYS=true
BREAK_GLASS_STEPS=3
BREAK_GLASS_BACKOFF_MS=1000
IMMEDIATE_REFILL_TIMEOUT_MS=1200

# ingest new hashes
MONGO_CHANGE_STREAMS=true
MONGO_POLL_INTERVAL_MS=2000

