# app config
PORT=3001
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=gta:
MONGO_URL=mongodb://localhost:27017/guesstheai
BACKUP_CACHE_DIR=./cache/backup
CORS_ALLOWED_ORIGINS=https://guesstheai.xyz,http://localhost:5172,http://localhost:5173,http://localhost:5174

# jwt conf
JWT_SECRET=hgfdjfvsdj4364hhgajgd
JWT_EXPIRES_IN=7d

VRF_SECRET_KEY=hOIGECD548fbfdjszmwp

# must be put in false in production
ENABLE_CRASH_ENDPOINT=false

# web sockets activity tracking config
# only multiplier of this value will be accepted
PRESENCE_CLIENT_FLUSH_QUANTUM_MS=60000
# wait to this value before flush to mongo
PRESENCE_DURABLE_BATCH_MS=360000
# ttl in redis
PRESENCE_REDIS_TTL_SECONDS=172800
# interval to run sweeper for flushing
PRESENCE_FLUSH_INTERVAL_MS=180000

# cache ahead config
# should load data from redis first or not
LOAD_FROM_REDIS=true
# interval(seconds) to flush redis data in mongo
REDIS_DATA_FLUSH=1000
# number of users needs to be flushed in one time
REDIS_DATA_FLUSH_BATCH=10000

# -------- Configurable Expiry and Per-User Images ---------
ACTIVE_USER_EXPIRY_SEC=600      # e.g., 10 minutes

# --- Warmup / cache targets ---
CACHE_MIN_READY=5000           # target # of hashes preloaded in Redis ready:q
WARMER_CONCURRENCY=8            # parallel fetches when warming

# Optional background top-up loop (keeps queue near target)
PER_TOPUP_INTERVAL_SEC=30         # 0 = disabled; e.g., 60 to check every 60s
PER_TOPUP_TARGET=10             # target to maintain in ready:q

# cooldowns (keep your current values if set)
IMAGE_COOLDOWN_DAYS=7           # per-user cooldown

MAX_ATTEMPTS=30 #max number of attempts to find suitable hash

IMAGES_LIST_SIZE=10 # number of images to send in batch "/game/next10" api

ONCHAIN_RPC_URL=https://evmrpc.0g.ai
ONCHAIN_PRIVATE_KEY=0x831160e220af35020bf00b1ceeb99e379855f65c7df6211b31adddafaa13280f
ONCHAIN_CHAIN_ID=16661
