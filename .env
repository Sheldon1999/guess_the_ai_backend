PORT=3001
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://admin:bulletstorm_ku1t_games@178.159.43.214:27017/guesstheai?authSource=admin
CACHE_DIR=./cache/orig
CORS_ALLOWED_ORIGINS=https://guesstheai.xyz,http://localhost:5172,http://localhost:5173,http://localhost:5174
ENABLE_CRASH_ENDPOINT=true

# -------- Image file fetching (0g) --------
# Primary mode for warming files; cold path in GET /img uses HTTP pass-through.
FETCH_MODE=HTTP            # HTTP | CLI
FETCH_FALLBACK=true          # try the other mode if primary fails

OGSOURCE_BASE=https://indexer-storage-turbo.0g.ai/file?root=
OG_INDEXER_URL=https://indexer-storage-turbo.0g.ai/
OG_CLI_BIN=/Users/ankurgangwar/Dev/fl/go/0g/0g-storage-client/0g-storage-client
OG_CLI_PROOF=false
OG_CLI_RPC_RETRY_COUNT=5
OG_CLI_RPC_RETRY_INTERVAL=5s
OG_CLI_RPC_TIMEOUT=30s

# HTTP fetch limits
HTTP_READ_TIMEOUT_MS=45000
HTTP_MAX_CONTENT_BYTES=5242880

# -------- Truth labels source --------
KV_MODE=MONGO                # MONGO | CLI (we're using Mongo now)

# -------- Configurable Expiry and Per-User Images ---------
ACTIVE_USER_EXPIRY_SEC=600      # e.g., 10 minutes
PER_USER_IMAGES=50               # images per active user for top-up

# --- Warmup / cache targets ---
CACHE_MIN_READY=2000              # target # of hashes preloaded in Redis ready:q
STARTUP_WARM_FROM_MONGO=true    # on boot: fill to target using images collection (hash+uploadedAt)
STARTUP_WARM_LIMIT=2000         # max latest images to be taken from mongo to download in cache
WARMER_CONCURRENCY=8            # parallel fetches when warming

# Optional background top-up loop (keeps queue near target)
PREFETCH_INTERVAL_SEC=3600         # 0 = disabled; e.g., 60 to check every 60s
PREFETCH_TARGET=500             # target to maintain in ready:q

# cooldowns (keep your current values if set)
IMAGE_COOLDOWN_DAYS=7           # per-user cooldown

MAX_ATTEMPTS=30 #max number of attempts to find suitable hash

IMAGES_LIST_SIZE=10 # number of images to send in batch "/game/next10" api

# jwt conf
JWT_SECRET=hgfdjfvsdj4364hhgajgd
JWT_EXPIRES_IN=7d

# web sockets activity tracking config
PRESENCE_DURABLE_BATCH_MS=360000
PRESENCE_REDIS_TTL_SECONDS=172800
PRESENCE_FLUSH_INTERVAL_MS=180000